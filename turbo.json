{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": ["content/**"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".svelte-kit/**", "build/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"@hyper-chamber/web#build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**"],
			"cache": false
		}
	}
}
