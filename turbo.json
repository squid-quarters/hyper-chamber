{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": ["content/**"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".svelte-kit/**", "build/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"@hyper-chamber/web#build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**"],
			"cache": false
		},
		"@hyper-chamber/desktop#build": {
			"dependsOn": ["@hyper-chamber/server#build", "@hyper-chamber/web#build"],
			"cache": false,
			"outputs": ["src-tauri/target/release/bundle/**"]
		}
	}
}
