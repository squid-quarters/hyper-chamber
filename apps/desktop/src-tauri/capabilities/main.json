{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main",
	"description": "Native window controls for the app-owned loopback interface.",
	"windows": ["main"],
	"remote": {
		"urls": ["http://127.0.0.1:*"]
	},
	"permissions": [
		"allow-get-host-info",
		"allow-set-sharing-enabled",
		"allow-import-content-pack",
		"allow-create-backup",
		"allow-choose-library-folder",
		"allow-reveal-library-folder"
	]
}
