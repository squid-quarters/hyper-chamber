{
	"name": "@hyper-chamber/desktop",
	"version": "1.0.0-beta.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare:resources": "node ../../tools/desktop/prepare.mjs",
		"dev": "tauri dev --no-watch",
		"build": "tauri build",
		"typecheck": "cargo check --manifest-path src-tauri/Cargo.toml",
		"test": "node --test ../../tools/desktop/pack.test.mjs && cargo test --manifest-path src-tauri/Cargo.toml",
		"format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
		"lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
	},
	"dependencies": {
		"fflate": "0.8.2"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.12.4"
	}
}
