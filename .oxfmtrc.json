{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"bracketSpacing": false,
	"arrowParens": "avoid",
	"printWidth": 100,
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/build/**",
		"**/.svelte-kit/**",
		"**/.turbo/**",
		"**/pnpm-lock.yaml",
		"**/static/media/**"
	]
}
