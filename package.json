{
	"name": "hyper-chamber",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @hyper-chamber/web dev",
		"start": "pnpm --filter @hyper-chamber/web preview --host 127.0.0.1 --port 5376 --strictPort",
		"build": "turbo run build",
		"lint": "oxlint .",
		"format": "oxfmt . && pnpm format:svelte",
		"format:check": "oxfmt --check . && pnpm format:svelte:check",
		"typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"content:check": "node --experimental-strip-types tools/check-content.ts",
		"verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm content:check",
		"prepare": "husky",
		"format:svelte": "prettier --plugin prettier-plugin-svelte --write \"apps/**/*.svelte\"",
		"format:svelte:check": "prettier --plugin prettier-plugin-svelte --check \"apps/**/*.svelte\""
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@types/node": "26.6.6",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"turbo": "2.11.10",
		"typescript": "6.0.3",
		"vitest": "5.1.0"
	},
	"lint-staged": {
		"*.{ts,js,mjs,json,css,md,yaml,yml}": [
			"oxfmt"
		],
		"*.{ts,js,mjs}": [
			"oxlint"
		]
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.16.1"
}
