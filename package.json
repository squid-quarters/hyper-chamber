{
	"name": "hyper-chamber",
	"version": "1.0.0-beta.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node tools/desktop/local-server.mjs dev",
		"start": "node tools/desktop/local-server.mjs start",
		"build": "turbo run build --filter=!@hyper-chamber/desktop",
		"lint": "oxlint .",
		"format": "oxfmt . && pnpm format:svelte",
		"format:check": "oxfmt --check . && pnpm format:svelte:check",
		"typecheck": "turbo run typecheck --filter=!@hyper-chamber/desktop && tsc -p tsconfig.tools.json --noEmit",
		"test": "vitest run && node --test tools/desktop/pack.test.mjs",
		"test:watch": "vitest",
		"content:check": "node --experimental-strip-types tools/check-content.ts",
		"verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm content:check",
		"prepare": "husky",
		"format:svelte": "prettier --plugin prettier-plugin-svelte --write \"apps/**/*.svelte\"",
		"format:svelte:check": "prettier --plugin prettier-plugin-svelte --check \"apps/**/*.svelte\"",
		"desktop:build": "pnpm --filter @hyper-chamber/server build && pnpm --filter @hyper-chamber/web build && pnpm --filter @hyper-chamber/desktop build",
		"desktop:dev": "pnpm --filter @hyper-chamber/server build && pnpm --filter @hyper-chamber/web build && pnpm --filter @hyper-chamber/desktop dev",
		"desktop:pack": "node tools/desktop/create-pack.mjs",
		"desktop:check": "pnpm --filter @hyper-chamber/desktop format:check && pnpm --filter @hyper-chamber/desktop lint && pnpm --filter @hyper-chamber/desktop test"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@types/node": "26.6.6",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"turbo": "2.11.10",
		"typescript": "6.0.3",
		"vitest": "5.1.0"
	},
	"lint-staged": {
		"*.{ts,js,mjs,json,css,md,yaml,yml}": [
			"oxfmt"
		],
		"*.{ts,js,mjs}": [
			"oxlint"
		]
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.16.1"
}
